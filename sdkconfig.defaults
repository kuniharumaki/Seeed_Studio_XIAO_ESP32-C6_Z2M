# Zigbee Options
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y

# Coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# USB CDC for Serial
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS Hz (Usually needed for Zigbee)
CONFIG_FREERTOS_HZ=1000

# Interrupt Watchdog Timeout (1000ms to allow coexistence RF scheduling)
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000
CONFIG_ESP_INT_WDT_CHECK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="custom.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# MMU Page Size (Fix 64KB alignment mismatch between linker script and esptool)
CONFIG_MMU_PAGE_SIZE_64KB=y
CONFIG_MMU_PAGE_SIZE=0x10000

# Task Stack Sizes (Fix sys_evt stack overflow on WPA3-SAE / Coex)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Core Dump to Flash (uses 64KB coredump partition at 0x356000)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

